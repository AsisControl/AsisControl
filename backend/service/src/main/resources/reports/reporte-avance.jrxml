<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="ReporteAvance" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35">
<style name="Base" default="true" fontName="DejaVu Sans" fontSize="9"/>
<parameter name="titulo" class="java.lang.String"/>
<parameter name="alumno" class="java.lang.String"/>
<parameter name="curso" class="java.lang.String"/>
<parameter name="docente" class="java.lang.String"/>
<parameter name="periodo" class="java.lang.String"/>
<parameter name="generado" class="java.lang.String"/>
<field name="competencia" class="java.lang.String"/>
