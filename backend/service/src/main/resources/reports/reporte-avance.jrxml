<element kind="staticText" positionType="Float" x="166" y="39" width="53" height="19" mode="Opaque" backcolor="#163653" forecolor="#FFFFFF" bold="true"><text><![CDATA[Nivel]]></text></element>
<element kind="staticText" positionType="Float" x="219" y="39" width="51" height="19" mode="Opaque" backcolor="#163653" forecolor="#FFFFFF" bold="true"><text><![CDATA[Peso]]></text></element>
<element kind="staticText" positionType="Float" x="270" y="39" width="245" height="19" mode="Opaque" backcolor="#163653" forecolor="#FFFFFF" bold="true"><text><![CDATA[Observación]]></text></element>
</band></groupHeader>
</group>
<pageHeader height="104">
<element kind="staticText" x="0" y="0" width="515" height="16" forecolor="#526580" fontSize="10" bold="true"><text><![CDATA[ASISCONTROL]]></text></element>
<element kind="textField" x="0" y="18" width="515" height="24" forecolor="#163653" fontSize="17" bold="true"><expression><![CDATA[$P{titulo}]]></expression></element>
<element kind="textField" x="0" y="45" width="515" height="14" bold="true" textAdjust="StretchHeight"><expression><![CDATA[$P{alumno}]]></expression></element>
<element kind="textField" positionType="Float" x="0" y="60" width="515" height="14" textAdjust="StretchHeight"><expression><![CDATA[$P{curso}]]></expression></element>
