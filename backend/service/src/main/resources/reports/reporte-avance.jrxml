<field name="fecha" class="java.lang.String"/>
<field name="resultado" class="java.lang.String"/>
<field name="ponderacion" class="java.lang.String"/>
<field name="observacion" class="java.lang.String"/>
<group name="Evaluacion" minHeightToStartNewPage="84" minDetailsToStartFromTop="1" reprintHeaderOnEachPage="true">
<expression><![CDATA[$F{idEvaluacion}]]></expression>
<groupHeader>
<band height="60" splitType="Prevent">
<element kind="textField" x="0" y="4" width="515" height="17" forecolor="#163653" fontSize="11" bold="true" textAdjust="StretchHeight"><expression><![CDATA[$F{evaluacion}]]></expression></element>
<element kind="textField" positionType="Float" x="0" y="22" width="515" height="14" forecolor="#526580"><expression><![CDATA[$F{fecha}]]></expression></element>
