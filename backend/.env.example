# Perfil de ejecucion: local o mysql
SPRING_PROFILES_ACTIVE=mysql

# Conexion MySQL. No colocar credenciales reales en el repositorio.
DB_URL=jdbc:mysql://localhost:3306/asiscontrol_pruebas?useSSL=false&serverTimezone=America/Lima&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Al menos 32 caracteres. En produccion debe provenir de un gestor de secretos.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=15

# Solo para HTTP local. En produccion HTTPS usar true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict

# Origenes del frontend separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Administrador inicial opcional. Solo se crea cuando las tres variables existen.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_DOCUMENT=12345678
BOOTSTRAP_ADMIN_EMAIL=admin@colegio.test
# Definir BOOTSTRAP_ADMIN_PASSWORD en la terminal: 8-64 caracteres, mayúscula, minúscula y número.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Directorio local para archivos adjuntos.
FILE_STORAGE_PATH=./storage

# Recuperación por correo: activar solamente al configurar el SMTP autorizado del colegio.
APP_MAIL_ENABLED=false
APP_MAIL_FROM=
APP_FRONTEND_URL=http://localhost:3000
# US-13 / US-48. FRONTEND_URL, si se define, tiene precedencia sobre APP_FRONTEND_URL.
# Celular en la misma Wi-Fi: http://192.168.x.x:3000; CORS debe admitir ese mismo origen.
FRONTEND_URL=http://localhost:3000
PAYMENTS_SIMULATOR_ENABLED=true
INSTITUTION_NAME=Colegio PUCP
# Opt-in de demostración solo en perfil local. Definir contraseña fuera del repositorio.
PAYMENTS_DEMO_ENABLED=false
PAYMENTS_DEMO_PASSWORD=
# Proveedor implementado: simulador local compatible en escenarios con Stripe Test Mode.
# No requiere STRIPE_SECRET_KEY ni STRIPE_PUBLISHABLE_KEY y no envía datos a Stripe.
# Una futura integración Stripe real necesita adaptador y webhook con verificación de firma;
# añadir claves por sí solo no activa ese proveedor. Nunca usar claves sk_live en este simulador.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
