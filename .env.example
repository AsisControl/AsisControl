# Copiar a .env en la raiz. Nunca subir valores reales a Git.
# MySQL local desde Docker: host.docker.internal. Para RDS: su endpoint completo.
DB_URL=jdbc:mysql://host.docker.internal:3306/asiscontrol_pruebas
DB_USERNAME=
DB_PASSWORD=
# Generar un valor aleatorio privado de al menos 32 caracteres.
JWT_SECRET=

# Pagos US-13/US-48: simulación académica, sin dinero real.
PAYMENTS_SIMULATOR_ENABLED=true
INSTITUTION_NAME="Colegio PUCP"
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Las semillas de familias son opt-in y solo funcionan con el perfil local del backend.
# No habilitarlas en una base compartida ni subir sus contraseñas a Git.
PAYMENTS_DEMO_ENABLED=false
PAYMENTS_DEMO_PASSWORD=
