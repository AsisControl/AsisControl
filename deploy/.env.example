# Copiar como .env SOLO en EC2. Valores de ejemplo, sin credenciales reales.
# Reemplaza la IP de ejemplo por la IPv4 publica actual de EC2, sin barra final.
APP_URL=http://192.0.2.10
# false SOLO para la demostracion HTTP. Con https://TU_DOMINIO usar true.
AUTH_COOKIE_SECURE=false
# APP_URL debe coincidir exactamente con PUBLIC_APP_URL en GitHub.
IMAGE_PREFIX=ghcr.io/asiscontrol/asiscontrol
# SHA completo de 40 caracteres publicado por el workflow, no latest.
IMAGE_TAG=
# Cifrado JDBC requerido. VERIFY_IDENTITY requiere configurar ademas la CA de RDS.
DB_URL='jdbc:mysql://ENDPOINT_RDS:3306/asiscontrol?sslMode=REQUIRED'
DB_USERNAME=
# Usa comillas simples para conservar caracteres como $ y #.
DB_PASSWORD=''
JWT_SECRET=''

# US-13/US-48: mostrar claramente que se trata de pagos simulados.
PAYMENTS_SIMULATOR_ENABLED=true
INSTITUTION_NAME='Colegio PUCP'
# La URL del QR se deriva de APP_URL en compose; no usar localhost en el servidor.
# Las semillas de familias de prueba permanecen desactivadas en el despliegue.
