{$APP_URL} {
    @api path /api /api/*
    handle @api {
        reverse_proxy backend:8080
    }
    handle /healthz {
        rewrite * /actuator/health
        reverse_proxy backend:8080
    }
    handle /actuator* {
        respond 404
    }
    handle {
        reverse_proxy frontend:3000
    }
}
